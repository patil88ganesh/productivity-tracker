{
  "manifest_version": 3,
  "name": "Productivity Tracker Focus Protection",
  "version": "2.5.3",
  "description": "Pauses Productivity Tracker while a supported social-media or WhatsApp Web tab is active.",
  "key": "",
  "permissions": [
    "nativeMessaging"
  ],
  "host_permissions": [
    "*://facebook.com/*",
    "*://*.facebook.com/*",
    "*://instagram.com/*",
    "*://*.instagram.com/*",
    "*://x.com/*",
    "*://*.x.com/*",
    "*://twitter.com/*",
    "*://*.twitter.com/*",
    "*://reddit.com/*",
    "*://*.reddit.com/*",
    "*://linkedin.com/*",
    "*://*.linkedin.com/*",
    "*://youtube.com/*",
    "*://*.youtube.com/*",
    "*://tiktok.com/*",
    "*://*.tiktok.com/*",
    "https://web.whatsapp.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Productivity Tracker Focus Protection",
    "default_icon": "icon.png"
  },
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
