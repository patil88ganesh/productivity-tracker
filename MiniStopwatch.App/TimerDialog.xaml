<Window x:Class="MiniStopwatch.App.TimerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set Timer"
        Width="360"
        Height="230"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#F5F8FA">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Countdown timer"
                   Foreground="#263845"
                   FontSize="19"
                   FontWeight="SemiBold"/>
        <TextBlock Grid.Row="1"
                   Margin="0,4,0,18"
                   Text="Enter the duration and the timer will start immediately."
                   Foreground="#6D7D88"
                   FontSize="12"/>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBox x:Name="HoursTextBox"
                         Text="00"
                         MaxLength="2"
                         HorizontalContentAlignment="Center"
                         FontFamily="Consolas"
                         FontSize="22"
                         Padding="6"/>
                <TextBlock Text="Hours"
                           Margin="0,5,0,0"
                           HorizontalAlignment="Center"
                           Foreground="#71818C"
                           FontSize="11"/>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBox x:Name="MinutesTextBox"
                         Text="25"
                         MaxLength="2"
                         HorizontalContentAlignment="Center"
                         FontFamily="Consolas"
                         FontSize="22"
                         Padding="6"/>
                <TextBlock Text="Minutes"
                           Margin="0,5,0,0"
                           HorizontalAlignment="Center"
                           Foreground="#71818C"
                           FontSize="11"/>
            </StackPanel>

            <StackPanel Grid.Column="4">
                <TextBox x:Name="SecondsTextBox"
                         Text="00"
                         MaxLength="2"
                         HorizontalContentAlignment="Center"
                         FontFamily="Consolas"
                         FontSize="22"
                         Padding="6"/>
                <TextBlock Text="Seconds"
                           Margin="0,5,0,0"
                           HorizontalAlignment="Center"
                           Foreground="#71818C"
                           FontSize="11"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="3"
                    Margin="0,18,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Cancel"
                    Width="80"
                    Margin="0,0,9,0"
                    Padding="8,5"
                    IsCancel="True"/>
            <Button Content="Start timer"
                    Width="96"
                    Padding="8,5"
                    IsDefault="True"
                    Click="StartTimer_Click"/>
        </StackPanel>
    </Grid>
</Window>
