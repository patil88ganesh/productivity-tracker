<Window x:Class="MiniStopwatch.App.StatsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="My stats (mini)"
        Width="236"
        Height="196"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        WindowStartupLocation="Manual"
        Topmost="True">
    <Border CornerRadius="9"
            BorderThickness="1"
            BorderBrush="#A02D96E8"
            Background="#F5FFFFFF"
            Padding="10,8"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10"
                              Direction="270"
                              ShadowDepth="2"
                              Opacity="0.24"
                              Color="#404850"/>
        </Border.Effect>
        <StackPanel>
            <TextBlock Text="Date       | Day | Hours"
                       FontFamily="Consolas"
                       FontSize="13"
                       FontWeight="Bold"
                       Foreground="#30404B"
                       Margin="0,0,0,4"/>
            <Separator Margin="0,0,0,4"/>
            <ItemsControl x:Name="Rows">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   FontFamily="Consolas"
                                   FontSize="13"
                                   Foreground="#4C5962"
                                   Margin="0,1"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</Window>
